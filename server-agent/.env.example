# server-agent — configurazione (copia in .env, non committare)

# Porta HTTP dell'agent (raggiungibile solo dalla VCN / control plane)
AGENT_PORT=8787
AGENT_BIND=0.0.0.0

# Token condiviso col backend control plane (obbligatorio in produzione).
# Il backend invia: Authorization: Bearer <token>
AGENT_TOKEN=changeme-shared-token

# --- ARK / filesystem -------------------------------------------------------
# Directory di installazione del server ASA (volume persistente del container)
ARK_INSTALL_DIR=/data/ark
# Profili-mappa persistenti (i default dell'immagine vengono copiati qui)
ARK_MAPS_DIR=/data/maps
# File ini del server
ARK_GUS_INI=/data/ark/ShooterGame/Saved/Config/WindowsServer/GameUserSettings.ini
ARK_GAME_INI=/data/ark/ShooterGame/Saved/Config/WindowsServer/Game.ini

# File che registra la mappa/mod attive (letti dal launcher Proton)
ARK_ACTIVE_MAP_FILE=/data/active-map
ARK_ACTIVE_PROFILE_FILE=/data/active-profile
ARK_ACTIVE_CONFIG_FILE=/data/active-configuration.json
ARK_MOD_VERSIONS_FILE=/data/mod-versions.json
ARK_ACTIVE_MODS_FILE=/data/active-mods
# Argomenti ASA avanzati della configurazione attiva (uno per riga)
ARK_LAUNCH_ARGS_FILE=/data/arksa-launch-args
# Account EOS/ARK amministratori, uno per riga (gestiti dalla PWA admin)
ARK_ALLOWED_CHEATER_ACCOUNTS_FILE=/data/ark/ShooterGame/Saved/AllowedCheaterAccountIDs.txt
# Polling dell'endpoint loopback derivato automaticamente da AGENT_PORT
# (minimo ASA: 3 secondi).
ARK_ADMIN_LIST_REFRESH_SECONDS=5
ARK_STEAMCMD_SCRIPT=/opt/steamcmd/steamcmd.sh
ARK_XAUDIO_REDIST_FILE=/opt/arksa/redist/xaudio2_9.dll
ARK_UPDATE_TIMEOUT_SEC=1800

# Script di avvio: spawn/kill diretto di ARK (nessun systemd nel container)
ARK_LAUNCH_SCRIPT=/opt/arksa/launch.sh
# File dove viene tracciato il pid del processo ARK
ARK_PID_FILE=/data/ark.pid
# Secondi di attesa dopo SIGTERM prima di forzare SIGKILL
ARK_STOP_TIMEOUT_SEC=30
# ASA completa il flush del save dopo la risposta RCON di saveworld.
ARK_SAVE_SETTLE_SEC=15

# --- RCON -------------------------------------------------------------------
RCON_HOST=127.0.0.1
RCON_PORT=27020
RCON_PASSWORD=changeme-rcon

# --- Auto-stop --------------------------------------------------------------
# Minuti di inattività (0 giocatori) prima dello self-stop. 0 = disabilitato.
IDLE_STOP_MINUTES=20
# Intervallo di polling RCON del watcher (secondi)
WATCHER_INTERVAL_SEC=60

# --- OCI self-stop ----------------------------------------------------------
# OCID dell'istanza game server (per lo stop di sé via instance principal).
# In produzione si ricava da instance metadata se non impostato.
OCI_INSTANCE_OCID=
# Usa instance principal per autenticarsi (nessuna chiave statica)
OCI_AUTH=instance_principal

# --- Backup salvataggi (Object Storage) -------------------------------------
# Bucket di destinazione (creato da Terraform, modulo storage). Vuoto = backup disabilitato.
BACKUP_BUCKET=

# --- Autoscaling storage (solo crescita) ------------------------------------
# OCI non permette di rimpicciolire un volume: questi parametri fanno CRESCERE
# il boot volume quando serve (nuove mod/mappe), mai ridurlo. Per contenere i
# costi nel tempo, pulire le mod inutilizzate (DELETE /mods/installed/:id).
# Soglia di occupazione disco (%) oltre la quale si amplia il volume
DISK_GROW_THRESHOLD_PCT=80
# Incremento per ogni crescita (GB)
DISK_GROW_STEP_GB=20
# Tetto massimo di sicurezza (GB): oltre non si cresce più automaticamente
DISK_GROW_MAX_GB=150
# Tempo minimo tra due crescite consecutive (minuti), evita chiamate OCI ripetute
DISK_GROW_COOLDOWN_MIN=60
# Tier ripristinato prima dello shutdown (10 = Balanced). Il control plane
# imposta 20/Higher Performance prima di accendere la VM.
ARK_BOOT_IDLE_VPUS=10

# --- Modalità sviluppo ------------------------------------------------------
# mock: non tocca systemd/RCON/OCI reali (per test in locale)
AGENT_MODE=mock
