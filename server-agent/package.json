{
  "name": "arksa-server-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent locale sul game server ARK: RCON, gestione mappe/mod/ini, metriche, watcher auto-stop.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "oci-common": "^2.80.0",
    "oci-core": "^2.80.0",
    "oci-objectstorage": "^2.80.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
