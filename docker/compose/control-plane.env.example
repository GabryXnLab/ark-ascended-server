# Copia in control-plane.env (gitignored) e compila i valori.
# Consumato da docker/compose/control-plane.compose.yml.

# Dominio pubblico per Caddy/TLS (Let's Encrypt). Serve solo se avvii il
# profilo "caddy" (host dedicato, vedi commento in control-plane.compose.yml).
# Senza dominio proprio si può usare "<ip-con-trattini>.sslip.io".
ARKSA_DOMAIN=example.com

# Porta su cui il backend è raggiungibile da 127.0.0.1 sull'host. Su un host
# CONDIVISO con altri progetti (nginx/reverse proxy già presenti) è la porta a
# cui va puntato il vhost esistente.
CONTROL_PLANE_HOST_PORT=3100

# Immagini pubblicate dalla CI (docker-build.yml); lasciare vuoto per buildare
# localmente con --build invece di scaricarle.
CONTROL_PLANE_IMAGE=ghcr.io/gabryxnlab/ark-ascended-control-plane:latest

# --- Passati al container backend (vedi control-plane/backend/.env.example) --
# ATTENZIONE "$" nei valori: questo file viene letto sia da Compose come
# "env_file:" del servizio backend SIA come "--env-file" per l'interpolazione
# del compose YAML — in entrambi i casi Compose espande "$NOME" come se fosse
# una propria variabile, anche qui. Un valore con "$" letterali (es. un hash
# bcrypt tipo "$2a$10$...") va scritto raddoppiando ogni "$" in "$$",
# altrimenti viene silenziosamente troncato/corrotto (verificato dal vivo).
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...anon...
SUPABASE_SECRET_KEY=eyJ...service_role...
ADMIN_EMAILS=admin@example.com
COMMUNITY_CREATION_ENABLED=true
# Deve restare false: la fondazione community non alloca risorse OCI.
FLEET_PROVISIONING_ENABLED=false

# --- Provider dell'istanza ----------------------------------------------------
# oci | docker | mock. Se assente: OCI_MODE=mock => mock, altrimenti oci.
# docker = modalita locale: il pannello avvia/ferma un container creato da Compose
# (niente OCI, niente costi, backup in cartella locale). Valore sconosciuto = exit.
INSTANCE_PROVIDER=oci
# Solo docker: Engine API raggiunta via socket proxy (consigliato) o socket diretto.
# DOCKER_HOST=tcp://docker-proxy:2375
# DOCKER_HOST=unix:///var/run/docker.sock
# DOCKER_API_VERSION=v1.41
# Nome del container del gioco (container_name nel compose; deve esistere gia).
# GAME_CONTAINER_NAME=arksa-game-server
# Host/IP mostrato come endpoint di gioco quando il server e acceso.
# PUBLIC_HOST=
# Solo display nella PWA: la porta reale la pubblica Compose.
# GAME_PORT=7777
# Cartella dei backup condivisa con l'agent (cancellazione dei salvataggi).
# BACKUP_DIR=/backups
# Attesa massima di "docker stop" (>= stop_grace_period del container).
# DOCKER_STOP_TIMEOUT_SEC=150

GAME_INSTANCE_OCID=
AGENT_URL=http://192.0.2.10:8787
AGENT_TOKEN=changeme-shared-token
OCI_MODE=instance_principal
POWER_START_STATE_FILE=/data/power-start.json
SHUTDOWN_STATE_FILE=/data/shutdown.json
OCI_START_RETRY_BASE_SEC=30
OCI_START_RETRY_MAX_SEC=300
GAME_BOOT_ACTIVE_VPUS=20
GAME_BOOT_IDLE_VPUS=10
OCI_TENANCY_OCID=
CURSEFORGE_API_KEY=

# Path dei file di stato: DEVONO stare sul volume /data (persistenti). I default
# nel codice (config.ts) sono relativi "./data/..." e falliscono in EACCES nel
# container: tenere questa lista allineata a config.ts, altrimenti boot-queue/
# current-config/savegames si rompono silenziosamente (successo dal vivo 2026-07-19).
PLAYTIME_DATA_FILE=/data/playtime-sessions.jsonl
REQUESTS_DATA_FILE=/data/pending-requests.json
CONFIGS_DATA_FILE=/data/game-configs.json
SAVEGAMES_DATA_FILE=/data/savegames.json
CURRENT_CONFIG_FILE=/data/current-config.json
BOOT_QUEUE_DATA_FILE=/data/boot-queue.json
ADMIN_WHITELIST_DATA_FILE=/data/admin-whitelist.json
IDLE_STOP_DATA_FILE=/data/idle-stop.json

# Timer auto-stop iniziale finché nessuno lo salva dalla PWA (stesso default
# dell'agent) e soglia del watchdog che spegne la VM se ASA non va online.
# IDLE_STOP_MINUTES=20
# OFFLINE_WATCHDOG_MINUTES=90

# Sentry (opzionale): errori del backend sul tuo progetto Sentry. Vuoto = spento.
SENTRY_DSN=
