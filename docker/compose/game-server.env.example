# Copia in game-server.env (gitignored) e compila i valori.
# Consumato da docker/compose/game-server.compose.yml.

GAME_SERVER_IMAGE=ghcr.io/gabryxnlab/ark-ascended-server-managed:latest
GAME_SERVER_DATA_VOLUME=arksa-game-data

# --- Agent -------------------------------------------------------------------
AGENT_TOKEN=changeme-shared-token
AGENT_MODE=live

# --- RCON (usato dall'agent, iniettato anche in launch.sh) -------------------
RCON_HOST=127.0.0.1
RCON_PORT=27020
RCON_PASSWORD=changeme-rcon
# Polling della whitelist PWA servita soltanto al processo ASA locale.
ARK_ADMIN_LIST_REFRESH_SECONDS=5

# --- Sessione di gioco (passati a launch.sh) ---------------------------------
SESSION_NAME=ARK Ascended Server
MAX_PLAYERS=20
GAME_PORT=7777
QUERY_PORT=27015
SERVER_PASSWORD=
SERVER_PLATFORM=ALL
EXTRA_ARGS=

# Il server-agent controlla e aggiorna ASA, mappe ufficiali e mod prima di ogni
# avvio della configurazione; non servono flag di update nell'entrypoint.
ARK_SAVE_SETTLE_SEC=15

# --- Tuning Wine/Proton (opzionali: già impostati a valori sensati in
# launch.sh, sovrascrivere solo per test A/B — vedi docs/PERFORMANCE.md) ------
# LP_NUM_THREADS=1
# WINEDEBUG=-all
# PROTON_NO_FSYNC=0
# PROTON_NO_ESYNC=0
# PROTON_USE_XALIA=0

# --- Auto-stop ----------------------------------------------------------------
# Solo valore iniziale: il control plane riapplica a ogni boot quello salvato dalla PWA.
IDLE_STOP_MINUTES=20
WATCHER_INTERVAL_SEC=60

# --- OCI self-stop / backup / autogrow (produzione OCI; vuoto = disabilitato) -
OCI_INSTANCE_OCID=
OCI_AUTH=instance_principal
BACKUP_BUCKET=
DISK_GROW_THRESHOLD_PCT=80
DISK_GROW_STEP_GB=20
DISK_GROW_MAX_GB=150
DISK_GROW_COOLDOWN_MIN=60

# --- Piattaforma dell'agent (oci = default; docker = modalità locale) --------
# In docker: self-stop con SIGTERM al processo, nessuna chiamata OCI, autogrow
# disattivato e backup in cartella locale al posto del bucket.
AGENT_PLATFORM=oci
# Solo docker: cartella dei backup (vuoto = backup disabilitato), versioni
# precedenti conservate per profilo e giorni massimi di conservazione.
BACKUP_DIR=
BACKUP_KEEP_VERSIONS=5
BACKUP_RETENTION_DAYS=30
# Tier persistente/a VM spenta; il control plane usa 20 durante la sessione.
ARK_BOOT_IDLE_VPUS=10
