# Copia in local.env (gitignored) e compila. Consumato da docker/compose/local.compose.yml
# con --env-file. Un "$" letterale in un valore va raddoppiato ("$$").

# --- Immagini ----------------------------------------------------------------
# Immagini pubblicate su GHCR dalla CI; per un fork sostituire il namespace
# con il proprio.
CONTROL_PLANE_IMAGE=ghcr.io/gabryxnlab/ark-ascended-control-plane:latest
GAME_SERVER_IMAGE=ghcr.io/gabryxnlab/ark-ascended-server-managed:latest

# --- Segreti -------------------------------------------------------------------
AGENT_TOKEN=changeme-shared-token
RCON_PASSWORD=changeme-rcon

# --- Auth (Supabase resta obbligatorio) ---------------------------------------
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...anon...
SUPABASE_SECRET_KEY=eyJ...service_role...
ADMIN_EMAILS=admin@example.com
COMMUNITY_CREATION_ENABLED=true
CURSEFORGE_API_KEY=

# --- Rete ----------------------------------------------------------------------
# Indirizzo mostrato ai giocatori come endpoint (IP pubblico o DNS dell'host).
PUBLIC_HOST=
GAME_PORT=7777
# 127.0.0.1 = pannello raggiungibile solo dall'host; 0.0.0.0 per aprirlo in LAN.
PANEL_BIND=127.0.0.1
PANEL_PORT=3100
# Solo con --profile caddy.
ARKSA_DOMAIN=example.com

# --- Docker --------------------------------------------------------------------
# GID del gruppo docker dell'host (socket proxy): getent group docker | cut -d: -f3
DOCKER_GID=999
GAME_CONTAINER_NAME=arksa-game-server
GAME_SERVER_DATA_VOLUME=arksa-game-data
DOCKER_STOP_TIMEOUT_SEC=150

# --- Backup --------------------------------------------------------------------
# Cartella host dei backup, condivisa da agent e pannello tramite gruppo BACKUP_GID:
#   relative to docker/compose (the compose file directory), not to the shell cwd:
#   mkdir -p docker/compose/backups && sudo chgrp 2000 docker/compose/backups && sudo chmod 2770 docker/compose/backups
BACKUP_HOST_DIR=./backups
BACKUP_GID=2000
BACKUP_KEEP_VERSIONS=5
BACKUP_RETENTION_DAYS=30

# --- Sessione di gioco ---------------------------------------------------------
SESSION_NAME=ARK Ascended Server
MAX_PLAYERS=20
SERVER_PASSWORD=
IDLE_STOP_MINUTES=20
