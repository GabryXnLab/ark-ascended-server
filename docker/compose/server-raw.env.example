# Copia in server-raw.env (gitignored) e compila i valori.
# Consumato da docker/compose/server-raw.compose.yml.

# Obbligatoria: password RCON e di amministrazione del server.
RCON_PASSWORD=changeme-rcon

# Mappa (default TheIsland_WP) e mod CurseForge (ID separati da virgola).
ARK_MAP=TheIsland_WP
ARK_MODS=

SESSION_NAME=ARK Ascended Server
MAX_PLAYERS=20
SERVER_PASSWORD=
# ALL = PC + console (crossplay); PC per il solo PC.
SERVER_PLATFORM=ALL
EXTRA_ARGS=

# 1 salta install/update SteamCMD all'avvio (gioco già installato nel volume).
ARK_SKIP_UPDATE=0
# Secondi di attesa dopo saveworld prima di terminare ASA.
ARK_SAVE_SETTLE_SEC=15
