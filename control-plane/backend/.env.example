# backend control plane — configurazione (copia in .env, non committare)

PORT=3000
BIND=0.0.0.0

# Google Auth / Supabase. La publishable key viene restituita alla PWA; la secret
# key resta solo nel backend. ADMIN_EMAILS è la bootstrap allowlist degli admin.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...anon...
SUPABASE_SECRET_KEY=eyJ...service_role...
ADMIN_EMAILS=admin@example.com
COMMUNITY_CREATION_ENABLED=true
# Guardrail economico/legale: non alloca VM o storage e deve restare false.
FLEET_PROVISIONING_ENABLED=false
# Cartella della PWA buildata da servire (vuoto = non servire static)
PWA_DIST=../pwa/dist

# --- Provider dell'istanza ----------------------------------------------------
# oci | docker | mock. Se assente: OCI_MODE=mock => mock, altrimenti oci.
# docker = modalita locale: il pannello avvia/ferma un container creato da Compose
# (niente OCI, niente costi, backup in cartella locale). Valore sconosciuto = exit.
INSTANCE_PROVIDER=oci
# Solo docker: Engine API raggiunta via socket proxy (consigliato) o socket diretto.
# DOCKER_HOST=tcp://docker-proxy:2375
# DOCKER_HOST=unix:///var/run/docker.sock
# DOCKER_API_VERSION=v1.41
# Nome del container del gioco (container_name nel compose; deve esistere gia).
# GAME_CONTAINER_NAME=arksa-game-server
# Host/IP mostrato come endpoint di gioco quando il server e acceso.
# PUBLIC_HOST=
# Solo display nella PWA: la porta reale la pubblica Compose.
# GAME_PORT=7777
# Cartella dei backup condivisa con l'agent (cancellazione dei salvataggi).
# BACKUP_DIR=/backups
# Attesa massima di "docker stop" (>= stop_grace_period del container).
# DOCKER_STOP_TIMEOUT_SEC=150

# --- Game server / agent ----------------------------------------------------
# OCID dell'istanza game server da accendere/spegnere
GAME_INSTANCE_OCID=
# Base URL dell'agent sul game server (rete privata VCN)
AGENT_URL=http://10.20.1.20:8787
# Token condiviso con il server-agent (== AGENT_TOKEN dell'agent)
AGENT_TOKEN=changeme-shared-token

# --- OCI --------------------------------------------------------------------
# mock: nessuna chiamata OCI reale (sviluppo locale)
# instance_principal: il control plane usa l'instance principal (produzione)
# config_file: usa ~/.oci/config (sviluppo con credenziali reali)
OCI_MODE=mock
# Per OCI_MODE=config_file: profilo da usare
OCI_PROFILE=DEFAULT
# Richiesta power-on persistente: in caso di capacità OCI esaurita riprova con
# backoff 30s → 60s → ... → massimo 5 minuti, anche dopo un restart del backend.
POWER_START_STATE_FILE=/data/power-start.json
SHUTDOWN_STATE_FILE=/data/shutdown.json
OCI_START_RETRY_BASE_SEC=30
OCI_START_RETRY_MAX_SEC=300
GAME_BOOT_ACTIVE_VPUS=20
GAME_BOOT_IDLE_VPUS=10

# --- Catalogo mod (CurseForge) -----------------------------------------------
# Chiave API gratuita: console.curseforge.com/api → "API Keys". Senza questa
# chiave la ricerca mod nella PWA (GET /mods/search) risponde con errore.
CURSEFORGE_API_KEY=

# --- Persistenza dati ---------------------------------------------------------
# Directory base dei file di stato. Nell'immagine Docker il default è /data;
# fuori da Docker resta ./data. I singoli *_DATA_FILE possono sovrascriverla.
# DATA_DIR=/data
# IMPORTANTE: in produzione questi path DEVONO puntare fuori dalla working copy
# del repo (es. /home/ubuntu/arksa-data/...), perché il workflow di deploy fa
# `git clean -fdx` sulla directory di deploy ad ogni push: qualunque file dati
# lasciato dentro il repo (path relativi di default) verrebbe cancellato a ogni
# aggiornamento della web app, azzerando amici, configurazioni e richieste.
# PLAYTIME_DATA_FILE=/home/ubuntu/arksa-data/playtime-sessions.jsonl
# REQUESTS_DATA_FILE=/home/ubuntu/arksa-data/pending-requests.json
# CONFIGS_DATA_FILE=/home/ubuntu/arksa-data/game-configs.json
# ADMIN_WHITELIST_DATA_FILE=/home/ubuntu/arksa-data/admin-whitelist.json
# QUEUED_CONFIG_FILE=/home/ubuntu/arksa-data/queued-config.json
